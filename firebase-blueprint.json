{
  "entities": {
    "ContentItem": {
      "title": "ContentItem",
      "description": "A persistent trivia or media item in the FanZone content bank.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the content item",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "description": "One of the 7 content bank categories",
          "enum": ["jersey", "photo", "stadium", "logo", "quiz", "number", "audio"],
          "maxLength": 32
        },
        "prompt": {
          "type": "string",
          "description": "Clue, title, or question text shown to players",
          "minLength": 1,
          "maxLength": 500
        },
        "answer": {
          "type": "string",
          "description": "Official private answer for the item",
          "minLength": 1,
          "maxLength": 300
        },
        "mediaUrl": {
          "type": "string",
          "description": "URL path to uploaded or sample image/audio asset",
          "maxLength": 1000
        },
        "blurAmount": {
          "type": "number",
          "description": "Starting mystery blur intensity in pixels (0 to 60) for image guess games"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated broadcast owner",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "category", "prompt", "answer", "ownerId", "createdAt"]
    },
    "GameSession": {
      "title": "GameSession",
      "description": "Live real-time game session state for FanZone broadcast",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Unique session identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "redScore": {
          "type": "number",
          "description": "Red team score"
        },
        "blueScore": {
          "type": "number",
          "description": "Blue team score"
        },
        "activeTeam": {
          "type": "string",
          "description": "Currently active team turn",
          "enum": ["red", "blue"],
          "maxLength": 8
        },
        "selectedCardNumber": {
          "type": "number",
          "description": "Currently selected card number (1 to 8)"
        },
        "stage": {
          "type": "string",
          "description": "Current stage of broadcast show",
          "enum": ["board", "minigame"],
          "maxLength": 16
        },
        "updatedAt": {
          "type": "number",
          "description": "Unix millisecond timestamp of last state modification"
        }
      },
      "required": ["sessionId", "redScore", "blueScore", "activeTeam", "selectedCardNumber", "stage", "updatedAt"]
    }
  },
  "firestore": {
    "/contentItems/{itemId}": {
      "schema": {
        "$ref": "#/entities/ContentItem"
      },
      "description": "Persistent content items owned by the studio broadcast owner"
    },
    "/gameSessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/GameSession"
      },
      "description": "Live broadcast game session state synchronized across devices and studio display"
    }
  }
}
